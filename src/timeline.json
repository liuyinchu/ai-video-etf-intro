  "scenes": [
    {
      "id": "opening",
      "chapter": "00 / 开场",
      "title": "一笔交易，装下一个市场",
      "subtitle": "ETF / EXCHANGE-TRADED FUND",
      "visual": "hero",
      "lines": [
        "买一只基金，就能间接持有几百家，甚至几千家公司的股票。",
        "这就是 ETF 最直观的魅力。",
        "但基金数量多、分红高，真的就更安全吗？",
        "本视频仅科普，不构成任何投资建议。"
      ],
      "from": 0,
      "duration": 563,
      "voiceFrom": 42,
      "voiceDuration": 14.993791,
      "bars": 10
    },
    {
      "id": "wrapper",
      "chapter": "01 / 原理",
      "title": "ETF，到底是什么？",
      "subtitle": "一份基金 · 一篮子资产 · 交易所买卖",
      "visual": "basket",
      "lines": [
        "ETF，英文是 Exchange Traded Fund，中文叫交易所交易基金。",
        "管理人把一组资产组织成基金，投资者买卖的是基金份额。",
        "你享有底层资产带来的收益，也承担它们的涨跌。"
      ],
      "from": 563,
      "duration": 506,
      "voiceFrom": 584,
      "voiceDuration": 14.493791,
      "bars": 9
    },
    {
      "id": "index",
      "chapter": "01 / 原理",
      "title": "交易形式 ≠ 投资策略",
      "subtitle": "先分清两个维度",
      "visual": "axes",
      "lines": [
        "ETF 回答的是，基金怎样交易。指数回答的是，资产按什么规则组合。",
        "ETF 可以跟踪指数，也可以主动管理。",
        "所以，看到 ETF 三个字，还不能判断它买了什么，更不能判断风险高低。"
      ],
      "from": 1069,
      "duration": 562,
      "voiceFrom": 1090,
      "voiceDuration": 16.505708,
      "bars": 10
    },
    {
      "id": "creation",
      "chapter": "01 / 原理",
      "title": "两层市场，一个连接",
      "subtitle": "二级市场交易 / 一级市场申购赎回",
      "visual": "mechanism",
      "lines": [
        "普通投资者主要在交易所，买卖已有的 ETF 份额。",
        "另一边，符合条件的机构，可以用证券篮子、现金或两者的组合，申购大额新份额，也能反向赎回。",
        "两层市场，就这样连在一起。"
      ],
      "from": 1631,
      "duration": 563,
      "voiceFrom": 1652,
      "voiceDuration": 16.208083,
      "bars": 10
    },
    {
      "id": "pricing",
      "chapter": "01 / 原理",
      "title": "价格为什么靠近净值？",
      "subtitle": "套利机制，让偏离有机会收敛",
      "visual": "premium",
      "lines": [
        "假设每份基金净值十元，市场却卖十元一角，就出现了百分之一的溢价。",
        "机构可能申购后卖出，推动偏离收敛。",
        "但时差、交易成本和申赎限制，会影响这个过程。市场价格并不保证等于净值。"
      ],
      "from": 2194,
      "duration": 562,
      "voiceFrom": 2215,
      "voiceDuration": 17.231873999999998,
      "bars": 10
    },
    {
      "id": "taxonomy",
      "chapter": "02 / 收益",
      "title": "先看资产，再看代码",
      "subtitle": "股票 / 债券 / 黄金",
      "visual": "taxonomy",
      "lines": [
        "ETF 是一种载体。股票、债券、黄金，装进去的资产不同，收益来源就不同。",
        "股票看企业盈利、股息和估值；债券看利息和价格；黄金主要看金价。",
        "先看资产类别，再看市场范围，最后看策略规则。"
      ],
      "from": 2756,
      "duration": 675,
      "voiceFrom": 2777,
      "voiceDuration": 19.493833,
      "bars": 12
    },
    {
      "id": "return",
      "chapter": "02 / 收益",
      "title": "总回报，才是完整的账",
      "subtitle": "价格变化 + 现金分配",
      "visual": "return",
      "lines": [
        "一百元买入，一段时间后价格变成一百一十元，同时收到三元分配。",
        "忽略税费，这次总回报是百分之十三。",
        "只盯价格涨幅，会漏掉分配。比较多年表现，通常还要计入分配再投资。"
      ],
      "from": 3431,
      "duration": 563,
      "voiceFrom": 3452,
      "voiceDuration": 15.839041,
      "bars": 10
    },
    {
      "id": "dividend",
      "chapter": "02 / 收益",
      "title": "分红不是凭空多一份钱",
      "subtitle": "除息机制 / 其他条件不变",
      "visual": "dividend",
      "lines": [
        "如果一份基金原来值一百元，派发三元，其他条件不变，",
        "除息后大致是九十七元基金，加三元现金。",
        "因此，高分红不自动等于高总回报。分配率、年化回报和债券收益率，也不是同一个指标。"
      ],
      "from": 3994,
      "duration": 562,
      "voiceFrom": 4015,
      "voiceDuration": 17.005708,
      "bars": 10
    },
    {
      "id": "coreus",
      "chapter": "03 / 产品",
      "title": "美国股票：大盘与全市场",
      "subtitle": "VOO / VTI",
      "visual": "us",
      "lines": [
        "先认识股票宽基。VOO 跟踪标普五百，主要覆盖美国大型企业。",
        "VTI 把美国中小型公司也纳入进来，但大公司依然占很大权重。",
        "它们的持仓重叠很多，基金里的公司更多，并不自动意味着风险更低。"
      ],
      "from": 4556,
      "duration": 563,
      "voiceFrom": 4577,
      "voiceDuration": 17.386665999999998,
      "bars": 10
    },
    {
      "id": "global",
      "chapter": "03 / 产品",
      "title": "把视野拉到全球",
      "subtitle": "VT / VXUS",
      "visual": "globe",
      "lines": [
        "VT 把美国和美国以外的股票放在一起，按全球市值结构配置。",
        "VXUS 则覆盖美国以外的发达和新兴市场。",
        "两者的关键区别，是是否包含美国股票。全球覆盖并不意味着各国平均分配，也不意味着不会下跌。"
      ],
      "from": 5119,
      "duration": 619,
      "voiceFrom": 5140,
      "voiceDuration": 18.922375,
      "bars": 11
    },
    {
      "id": "tilt",
      "chapter": "03 / 产品",
      "title": "同样是股票，风格可以很不同",
      "subtitle": "QQQ / QQQM / SCHD",
      "visual": "tilt",
      "lines": [
        "QQQ 和 QQQM 都跟踪纳斯达克一百，覆盖大型非金融公司，并不等同于纯科技行业。",
        "SCHD 按股息记录和财务质量筛选股票。",
        "这些筛选规则会带来不同风格，但高股息仍然是股票，也会下跌。"
      ],
      "from": 5738,
      "duration": 618,
      "voiceFrom": 5759,
      "voiceDuration": 17.791415999999998,
      "bars": 11
    },
    {
      "id": "income",
      "chapter": "03 / 产品",
      "title": "债券家族，不只有一种风险",
      "subtitle": "BND / SGOV / VGSH / VGIT / TLT",
      "visual": "ladder",
      "lines": [
        "BND 覆盖美国综合投资级债券，包含国债、公司债和抵押贷款支持证券。",
        "国债类产品还可以从短到长来看：SGOV、VGSH、VGIT，再到 TLT。",
        "同样叫债券，期限不同，价格波动可能差很多。"
      ],
      "from": 6356,
      "duration": 675,
      "voiceFrom": 6377,
      "voiceDuration": 20.100958,
      "bars": 12
    },
    {
      "id": "duration",
      "chapter": "03 / 产品",
      "title": "信用好，也可能跌得深",
      "subtitle": "信用风险与利率风险，需要分开看",
      "visual": "duration",
      "lines": [
        "久期，描述债券价格对市场收益率变化的敏感程度。",
        "其他条件相近时，久期越长，利率变化带来的价格冲击通常越大。",
        "TLT 持有二十年以上美国国债。发行人信用质量高，并不意味着价格稳定。"
      ],
      "from": 7031,
      "duration": 619,
      "voiceFrom": 7052,
      "voiceDuration": 17.565248999999998,
      "bars": 11
    },
    {
      "id": "durationmath",
      "chapter": "03 / 产品",
      "title": "利率上升，价格承压",
      "subtitle": "一阶估算 / 假设示例",
      "visual": "durationmath",
      "lines": [
        "用一个简化例子：假设有效久期是六年，市场收益率上升一个百分点，",
        "价格变化的一阶估计，大约是负百分之六。",
        "这还没有计入利息、凸性、信用利差和持仓调整。久期不是保本期限。"
      ],
      "from": 7650,
      "duration": 563,
      "voiceFrom": 7671,
      "voiceDuration": 15.743832,
      "bars": 10
    },
    {
      "id": "stress2022",
      "chapter": "03 / 产品",
      "title": "2022：股票和债券一起下跌",
      "subtitle": "同一日历年度 · 美元总回报近似",
      "visual": "bars",
      "lines": [
        "二零二二年，VOO 总回报约为负百分之十八点二，BND 约为负百分之十三点一。",
        "长久期的 TLT，约为负百分之三十一点二。",
        "股债关系会随环境变化。加了债券，也不能保证组合不跌。"
      ],
      "from": 8213,
      "duration": 562,
      "voiceFrom": 8234,
      "voiceDuration": 17.100915999999998,
      "bars": 10
    },
    {
      "id": "gold",
      "chapter": "03 / 产品",
      "title": "黄金：另一种收益来源",
      "subtitle": "GLD / 实物黄金信托",
      "visual": "gold",
      "lines": [
        "GLD 通过实物黄金提供金价敞口，法律结构是黄金信托。",
        "黄金没有企业利润，也没有票息，通常不提供现金分配。",
        "它可以增加资产种类，但金价也会长期下跌。分散价值和自身稳定性，需要分开理解。"
      ],
      "from": 8775,
      "duration": 619,
      "voiceFrom": 8796,
      "voiceDuration": 18.577166,
      "bars": 11
    },
    {
      "id": "region",
      "chapter": "03 / 产品",
      "title": "交易币种，不等于投资地区",
      "subtitle": "EWJ / 510300",
      "visual": "region",
      "lines": [
        "EWJ 在美国上市、用美元交易，底层主要是日本股票，仍有日元相关风险。",
        "五一零三零零，跟踪沪深三百，提供人民币计价的 A 股大盘股敞口。",
        "上市地、交易币种、投资地区，是三个不同的问题。"
      ],
      "from": 9394,
      "duration": 619,
      "voiceFrom": 9415,
      "voiceDuration": 17.446165999999998,
      "bars": 11
    },
    {
      "id": "finale",
      "chapter": "04 / 结语",
      "title": "看懂资产，才看懂 ETF",
      "subtitle": "买了什么？收益从哪来？承担哪些风险？",
      "visual": "finale",
      "lines": [
        "认识 ETF，不是背下一串代码，而是回答三个问题。",
        "买到的资产是什么，收益从哪里来，你承担哪些风险？",
        "带着这三个问题，再去阅读基金资料。",
        "本视频仅科普，不构成任何投资建议。历史表现不预示未来收益。"
      ],
      "from": 10013,
      "duration": 731,
      "voiceFrom": 10034,
      "voiceDuration": 19.100958,
      "bars": 11
    }
